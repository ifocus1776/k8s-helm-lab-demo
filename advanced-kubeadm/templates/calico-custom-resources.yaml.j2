# Rendered from Calico {{ calico_version }} manifests/custom-resources.yaml with the IP pool
# CIDR changed to match kubeadm --pod-network-cidr ({{ k8s_pod_cidr }}).
apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  calicoNetwork:
    ipPools:
      - name: default-ipv4-ippool
        blockSize: 26
        cidr: {{ k8s_pod_cidr }}
        encapsulation: {{ calico_encapsulation }}
        natOutgoing: Enabled
        nodeSelector: all()
---
apiVersion: operator.tigera.io/v1
kind: APIServer
metadata:
  name: default
spec: {}
{% if calico_enable_observability | bool %}
---
apiVersion: operator.tigera.io/v1
kind: Goldmane
metadata:
  name: default
---
apiVersion: operator.tigera.io/v1
kind: Whisker
metadata:
  name: default
{% endif %}
